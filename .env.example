# ==============================================================================
# KebabsChoice POS V2.0 - Production & Local Environment Variables Example
# ==============================================================================
# Di Vercel Dashboard -> Project Settings -> Environment Variables, masukkan:
# ==============================================================================

# 1. SUPABASE PROJECT URL
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# 2. SUPABASE ANON / PUBLISHABLE KEY
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon public)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here

# 3. SUPABASE SERVICE ROLE KEY (Serverless API / Admin)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Opsional: SUPABASE_URL untuk Serverless function
SUPABASE_URL=https://your-project.supabase.co
